{
  "name": "capacitor-AdRevKit",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor wrapper pointing to remote Capacitor AdRevKit web app.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "env:apply": "node scripts/apply-env.mjs",
    "cap:sync": "bash scripts/with-node20.sh sync",
    "cap:add:ios": "bash scripts/with-node20.sh add ios",
    "ios": "bash scripts/with-node20.sh open ios"
  },
  "dependencies": {
    "@capacitor-community/admob": "^7.0.3",
    "@capacitor-community/media": "^8.0.1",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "7.4.3",
    "@capacitor/ios": "7.4.3",
    "@capacitor/network": "^7.0.2",
    "@capacitor/status-bar": "^7.0.3",
    "@revenuecat/purchases-capacitor": "^11.2.3",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^16.6.1",
    "typescript": "^5.9.3"
  }
}
